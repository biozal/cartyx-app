{
  "name": "cartyx-app",
  "version": "0.2.0",
  "description": "Cartyx — D&D Campaign Management Platform",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "node -e \"const fs=require('fs'); if (fs.existsSync('.git')) require('child_process').execFileSync(process.platform === 'win32' ? 'npx.cmd' : 'npx', ['lefthook', 'install'], { stdio: 'inherit' });\"",
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "vite dev",
    "build": "NODE_ENV=production vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ci": "vitest run --project unit --coverage --reporter=verbose",
    "e2e": "playwright test",
    "e2e:container": "bash deploy/local/e2e-container.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook:full": "node scripts/build-storybook-with-iframe.mjs",
    "realtime:dev": "npm --prefix realtime run dev",
    "check:deps-age": "node scripts/check-package-age.mjs",
    "dev:clear": "tsx scripts/seed/cli.ts clear",
    "dev:seed": "tsx scripts/seed/cli.ts seed && tsx scripts/gen_seed_avatars.mjs && node scripts/gen_seed_lore_images.mjs && node scripts/gen_seed_org_images.mjs && node scripts/gen_seed_quest_images.mjs",
    "dev:repair-images": "tsx scripts/repair-images.ts && tsx scripts/gen_seed_avatars.mjs",
    "dev:gen-avatars": "tsx scripts/gen_seed_avatars.mjs",
    "fixture": "tsx scripts/dev-fixtures/cli.ts",
    "srd:lint": "tsx scripts/srd/lint.ts",
    "srd:extract": "tsx scripts/srd/extract-rules.ts",
    "srd:generate": "tsx scripts/srd/generate-srd-data.ts",
    "db:up": "node scripts/dev-data.mjs up",
    "db:schema": "node scripts/dev-schema.mjs",
    "db:down": "node scripts/dev-data.mjs down",
    "db:status": "node scripts/dev-data.mjs status",
    "db:smoke": "node scripts/dev-data.mjs smoke",
    "db:tools": "node scripts/dev-data.mjs tools",
    "db:chart-test": "node scripts/dev-data.mjs chart-test",
    "graph:schema": "tsx scripts/graph/cli.ts",
    "graph:reindex": "tsx scripts/graph/reindex.ts",
    "graph:test": "tsx scripts/graph/integration.ts",
    "cql:schema": "tsx scripts/cql/cli.ts",
    "cql:test": "tsx scripts/cql/integration.ts",
    "cql:local": "node scripts/cql/local.mjs",
    "identity:graph-schema": "tsx scripts/identity/profile-schema-cli.ts",
    "identity:resolve-revocation": "tsx scripts/identity/resolve-revocation.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/pro-solid-svg-icons": "file:./vendor/pro-solid-svg-icons",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/browser": "^10.74.0",
    "@sentry/node": "^10.74.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "cassandra-driver": "4.9.0",
    "dayjs": "^1.11.23",
    "gremlin": "3.8.2",
    "jose": "^6.2.12",
    "konva": "^10.5.0",
    "lucide-react": "^1.43.0",
    "mingo": "7.2.4",
    "nitro": "^3.0.260522-beta",
    "partysocket": "^1.3.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-konva": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stemmer": "2.0.1",
    "vite": "^7.3.6",
    "zod": "^4.6.1"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "h3-v2": "npm:h3@2.0.1-rc.19",
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "gremlin": {
      "uuid": "11.1.1"
    },
    "cassandra-driver": {
      "adm-zip": "0.6.1"
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/gremlin": "3.6.7",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "~5.1.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "^10.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "lefthook": "^2.1.12",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
