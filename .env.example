# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Apple (optional)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=keys/apple.p8

# Session (must be at least 32 chars in production)
SESSION_SECRET=

# Server (injected by the deploy environment in production)
PORT=3000
BASE_URL=http://localhost:3000

# Deployment environment: production | staging | development.
# Controls DB bootstrap policy, analytics labels, and the image-upload
# local-disk fallback (development only).
APP_ENV=development

# Database
MONGODB_URI=

# JanusGraph/Cassandra. `npm run db:up` starts the stack and writes local
# TLS/credentials into cartyx-infrastructure/.local/data/local; `npm run dev` then
# installs the schemas. Never commit those files or expose these settings as
# VITE_PUBLIC_*. For a non-sibling infrastructure checkout, export
# CARTYX_INFRASTRUCTURE_DIR=/absolute/path in your shell before npm run dev.
#
# These are the settings the APPLICATION runs with: a restricted principal that can
# read and write entities but cannot change a schema. Subsystems move to the graph one
# at a time, and each migrated subsystem needs them.
# GREMLIN_URL=wss://localhost:18182/gremlin
# GREMLIN_USERNAME=cartyx_app
# GREMLIN_PASSWORD_FILE=/absolute/path/to/cartyx-infrastructure/.local/data/local/gremlin-app-password
# GREMLIN_CA_FILE=/absolute/path/to/cartyx-infrastructure/.local/data/local/tls.crt
# GREMLIN_TIMEOUT_MS=10000
# GREMLIN_LOCAL_PORT=18182
# CQL_CONTACT_POINT=127.0.0.1
# CQL_PORT=19042
# CQL_TLS_SERVER_NAME=localhost
# CQL_DATACENTER=dc1
# CQL_STATE_KEYSPACE=cartyx_state
# CQL_CA_FILE=/absolute/path/to/cartyx-infrastructure/.local/data/local/tls.crt
# CQL_PASSWORD_FILE=/absolute/path/to/cartyx-infrastructure/.local/data/local/cassandra-state-password
# CQL_TIMEOUT_MS=10000
# DATA_SECRETS_DIR=/absolute/path/to/cartyx-infrastructure/.local/data/local

# Inspector feature flags — plain booleans baked into the client bundle at
# BUILD time ('true' or '1' enables, lowercase; anything else disables).
# Changing a value needs a rebuild (dev-server restart / new image build).
# Playwright e2e needs these set or the inspector tabs never render.

# Cloudflare R2 image storage
# When CDN_URL is set, images upload directly from browser to R2 (production)
# When CDN_URL is omitted (local dev), images save to public/uploads/ via server
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
CDN_URL=

# Realtime service (replaces PartyKit; same host/port so partysocket needs no changes)
VITE_PUBLIC_PARTYKIT_HOST=localhost:1999

# Server-side runtime override for broadcasting to the realtime service.
# Optional: defaults to VITE_PUBLIC_PARTYKIT_HOST. Uncomment and set when the
# server can't reach realtime at VITE_PUBLIC_PARTYKIT_HOST (browser-facing
# only), e.g. in containers where realtime is a service name, not localhost.
# REALTIME_INTERNAL_HOST=realtime:1999

# Observability — self-hosted GlitchTip (errors) + Umami (analytics). All
# four are optional: absent = telemetry disabled (safe no-op), same DX as the
# PostHog era. GLITCHTIP_DSN/UMAMI_WEBSITE_ID are read server-side at runtime;
# the VITE_PUBLIC_ counterparts are baked into the client bundle at build
# time. UMAMI_HOST defaults to https://umami.cartyx.io when unset.
GLITCHTIP_DSN=
UMAMI_WEBSITE_ID=
# UMAMI_HOST=https://umami.cartyx.io
VITE_PUBLIC_GLITCHTIP_DSN=
VITE_PUBLIC_UMAMI_WEBSITE_ID=

# Operator credentials belong to schema and fixture tooling, which supplies them
# itself (npm run db:schema, cql:local, graph:reindex). Keep them OUT of .env: the
# runtime refuses to start when it is handed cartyx_admin or CQL_ADMIN_PASSWORD_FILE,
# so a stray operator setting here breaks the application rather than the tooling.
# Set them in the shell for a one-off operator command against a remote environment:
#   GREMLIN_USERNAME=cartyx_admin
#   GREMLIN_PASSWORD_FILE=.../cartyx-infrastructure/.local/data/dev/gremlin-password
#   CQL_ADMIN_PASSWORD_FILE=.../cartyx-infrastructure/.local/data/dev/cassandra-admin-password
#   CQL_MIGRATION_OWNER=<persisted-operator-job-UUID-v4>
