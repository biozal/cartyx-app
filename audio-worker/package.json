{
  "name": "cartyx-audio-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/healthcheck.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outdir=dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "cassandra-driver": "4.9.0",
    "gremlin": "3.7.7",
    "mingo": "7.2.4",
    "pino": "^10.3.1",
    "stemmer": "2.0.1",
    "zod": "^4.6.1"
  },
  "overrides": {
    "postcss": "8.5.28",
    "gremlin": {
      "uuid": "11.1.1"
    },
    "cassandra-driver": {
      "adm-zip": "0.6.1"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
